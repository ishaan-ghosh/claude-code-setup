{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1",
  "theme": "dark",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "extraKnownMarketplaces": {
    "claude-code-setup": {
      "source": {
        "source": "github",
        "repo": "ishaan-ghosh/claude-code-setup",
        "ref": "v0.1.2"
      }
    }
  },
  "enabledPlugins": {
    "dev-setup@claude-code-setup": true
  },
  "env": {
    "READ_POLICY_MODE": "warn",
    "MODEL_POLICY_MODE": "deny"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
